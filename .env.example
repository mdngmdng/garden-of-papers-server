# Server
PORT=5002
ORIGIN=http://34.64.85.65:3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@gx-mongo.eau3o.mongodb.net

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=garden-of-papers

# GROBID (same VM)
GROBID_URL=http://localhost:8070

# Google Scholar metadata and relationship search
SERPAPI_KEY=

# LLM
LLM_API_KEY=
LLM_API_URL=
GEMINI_API_KEY=

# Ai2 Asta Scientific Corpus Tool (primary related-work retrieval)
# Request a key at https://allenai.org/asta/resources/mcp
ASTA_TOOL_KEY=
ASTA_MCP_ENDPOINT=https://asta-tools.allen.ai/mcp/v1
ASTA_REQUEST_TIMEOUT_MS=120000
ASTA_SNIPPET_LIMIT=60
ASTA_RELEVANCE_LIMIT=40

# Local semantic retrieval (server-side)
QWEN_ENABLED=true
QWEN_SERVICE_URL=http://127.0.0.1:8071
QWEN_DEVICE=auto
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
QWEN_TOP_K=12
QWEN_MINIMUM_RERANK_SCORE=0.55
QWEN_HIGH_CONFIDENCE_RERANK_SCORE=0.9
QWEN_MINIMUM_RERANK_MARGIN=0.04
